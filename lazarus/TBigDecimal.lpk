<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="TBigDecimal"/>
    <Type Value="RunTime"/>
    <Author Value="Liam Seamus Coughlin"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../src"/>
        <UnitOutputDirectory Value="../lib/lazarus/$(TargetCPU)-$(TargetOS)"/>

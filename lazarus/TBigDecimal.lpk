        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="3"/>
        </Optimizations>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Arbitrary-precision decimal arithmetic: the TBigDecimal record with rounding modes, a thread-local default context, Sqrt, Exp, Ln, Pow, trigonometry, combinatorics, Gamma and financial helpers."/>
    <License Value="LGPL-2.1-only WITH Independent-modules-exception"/>
